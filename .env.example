# Copie para .env e troque a senha. O .env não vai para o git.
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Adzuna: chave gratuita em https://developer.adzuna.com (1.000 chamadas/mês).
# Sem estas duas variáveis a fonte é pulada e a coleta segue normalmente.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
